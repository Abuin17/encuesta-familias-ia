# Cadena de conexion de Supabase: Project Settings > Database > Connection string > Transaction pooler (puerto 6543)
DATABASE_URL=postgresql://postgres.xxxxx:CONTRASENA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Primer dia de campo (para calcular la semana de cada respuesta)
CAMPO_INICIO=2026-10-05
# Email de contacto que aparece en el aviso informativo
NEXT_PUBLIC_CONTACTO=contacto@ejemplo.com
# Nombre del responsable que aparece en el aviso
NEXT_PUBLIC_RESPONSABLE=Manu Abuín
